{
  "name": "nznt-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nznt/api dev --filter @nznt/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @nznt/db prisma:generate",
    "db:migrate": "pnpm --filter @nznt/db prisma:migrate",
    "db:deploy": "pnpm --filter @nznt/db prisma:deploy",
    "db:studio": "pnpm --filter @nznt/db prisma:studio",
    "seed:admin": "pnpm --filter @nznt/db seed:admin",
    "migrate:legacy-keys": "tsx scripts/migrate-legacy-keys.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
